<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!--
      MAIN PLAYBACK & EXPANDABLE QUEUE CONTAINER (Sections 4, 5, 11, 12)
      When Queue is collapsed:
        - Playback controls are centered on screen (minimalist: Song Title, Progress Bar, Play/Pause, Shuffle).
        - Unobtrusive top navigation allows opening Library, Favorites, or switching Dark/Light theme.
        - Bottom contains the Screen-Off Mode button and the thin white horizontal queue drag handle line.
      When Queue handle is dragged upwards:
        - Playback controls smoothly transition to the top of the screen.
        - The persistent YouTube Music-style Queue expands to fill the space below.
    -->
    <LinearLayout
        android:id="@+id/mainContentColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Unobtrusive Top Bar for Library, Favorites, and Theme Switch -->
        <LinearLayout
            android:id="@+id/topNavigationRow"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/btnOpenLibrary"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/library_button"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnOpenFavorites"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/favorites_button"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnToggleTheme"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/theme_dark"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Dynamic Top Spacer: pushes playback cluster to center when queue is collapsed, shrinks to 0dp when queue expands -->
        <View
            android:id="@+id/topCenteringSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!--
          MINIMALIST PLAYBACK CLUSTER (Section 4):
          Contains strictly the 4 primary elements:
          1. Song title
          2. Progress bar (gradually fills as song plays, completely filled when finished)
          3. Pause/play button
          4. Shuffle button (clearly indicates enabled/disabled state without clutter)
        -->
        <LinearLayout
            android:id="@+id/playbackControlsCluster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="12dp"
            android:paddingEnd="32dp"
            android:paddingBottom="12dp">

            <!-- 1. Song Title (supports Hebrew/RTL and English seamlessly via textDirection="anyRtl") -->
            <TextView
                android:id="@+id/tvCurrentSongTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/no_song_selected"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textDirection="locale"
                android:textSize="18sp" />

            <!-- 2. Progress Bar -->
            <ProgressBar
                android:id="@+id/playbackProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="220dp"
                android:layout_height="4dp"
                android:layout_marginTop="16dp"
                android:max="1000"
                android:progress="0" />

            <!-- 3 & 4. Compact Centered Play/Pause and Shuffle Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Play or Pause"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play" />

                <ImageButton
                    android:id="@+id/btnShuffle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="24dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Toggle Shuffle"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_shuffle" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dynamic Bottom Spacer: keeps playback cluster centered when queue is collapsed -->
        <View
            android:id="@+id/bottomCenteringSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Completely Black Screen Mode Button (Section 12) -->
        <LinearLayout
            android:id="@+id/bottomUtilityRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/btnBlackScreenMode"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/black_screen_button"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />
        </LinearLayout>

        <!--
          EXPANDABLE QUEUE HANDLE & PANEL (Section 5, 6, 8, 9)
          At the very bottom when collapsed: thin, elegant white horizontal line.
          Dragging upwards expands the queue smoothly so controls sit at the top and queue fills below.
          Dragging the handle downwards collapses the queue back to the minimalist view.
        -->
        <LinearLayout
            android:id="@+id/queueHandleTouchArea"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/queueHandleLine"
                android:layout_width="56dp"
                android:layout_height="3dp"
                android:background="@drawable/bg_queue_handle_line" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/expandedQueueContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/tvQueueHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Queue"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvQueueCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#999999"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvQueue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />
        </LinearLayout>

    </LinearLayout>

    <!--
      DEDICATED LIBRARY & PLAYLIST OVERLAY SCREEN (Section 3 & 10)
      Organized strictly into:
      1. Playlists (at the top)
      2. Standalone Songs (below playlists, only root Music/ files)
      Plus dedicated Playlist detail screen when a playlist is tapped.
    -->
    <LinearLayout
        android:id="@+id/libraryScreenOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Library Top Header -->
        <LinearLayout
            android:id="@+id/libraryHeaderBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/btnCloseLibraryOrBack"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:paddingEnd="12dp"
                android:text="← Player"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvLibraryScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="LIBRARY"
                android:textColor="#FFFFFF"
                android:textDirection="locale"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCreatePlaylist"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/create_playlist"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnRefreshLibrary"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/refresh_library"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Search filter bar (supports Hebrew & English search across library) -->
        <EditText
            android:id="@+id/etLibrarySearch"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="6dp"
            android:background="@android:color/transparent"
            android:hint="Search playlists or songs (חיפוש)..."
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:textDirection="locale"
            android:textSize="13sp" />

        <!-- Playlist Detail Action Row (visible when viewing inside a specific playlist) -->
        <LinearLayout
            android:id="@+id/playlistDetailActionsRow"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnPlayEntirePlaylist"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/play_all"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnPlaylistPlayNext"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/play_next"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnPlaylistAddToQueue"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/add_to_queue"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLibraryContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />
    </LinearLayout>

    <!--
      COMPLETELY BLACK SCREEN MODE OVERLAY (Section 12)
      Covers the entire screen in pure #000000 with zero text, zero icons, zero indicators.
      Wakes ONLY on a verified double-tap via DoubleTapWakeDetector.
    -->
    <View
        android:id="@+id/blackoutScreenOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

</FrameLayout>
